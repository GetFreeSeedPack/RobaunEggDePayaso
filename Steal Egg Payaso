-- =============================================
--  INSTANT TP — NO TE REGRESA + ANTI-KICK
--  Se queda fijo · Bloquea el regreso · Seguro
-- =============================================

local Player = game:GetService("Players").LocalPlayer
local UIS = game:GetService("UserInputService")

-- 📍 TU ZONA SEGURA
local ZONA_SEGURA = Vector3.new(340.52, 4.00, -1.42)

-- ⚡ CONFIGURACIÓN
local ALTITUD_SEGURA = 1.0
local RETRASO_ANTI = 0.008
local BLOQUEAR_REGRESO = true -- ✅ EVITA QUE TE REGRESE
local TIEMPO_PROTECCION = 1.5 -- Mantiene la posición fija 1.5s

local Activo = false
local MenuMinimizado = false

-- 🛡️ TP SEGURO + MANTIENE POSICIÓN
local function TpSeguroFijo()
    if Activo then return end
    Activo = true

    local Char = Player.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then
        Activo = false
        return
    end
    local HRP = Char.HumanoidRootPart
    local Inicio = HRP.Position
    local Destino = ZONA_SEGURA + Vector3.new(0, ALTITUD_SEGURA, 0)

    -- ⚡ 4 pasos intermedios = el servidor lo ve como movimiento normal
    local Pasos = 4
    for i = 1, Pasos do
        if not Activo then break end
        local Progreso = i / Pasos
        local NuevaPos = Inicio:Lerp(Destino, Progreso)
        HRP.CFrame = CFrame.new(NuevaPos)
        task.wait(RETRASO_ANTI)
    end

    -- ✅ ATERRIZAJE FIRME — NO TE MUEVE
    if Activo then
        HRP.CFrame = CFrame.new(ZONA_SEGURA + Vector3.new(0, 0.5, 0))
        task.wait(0.02)
        HRP.CFrame = CFrame.new(ZONA_SEGURA + Vector3.new(0, 0.15, 0))
        task.wait(0.02)
        HRP.CFrame = CFrame.new(ZONA_SEGURA)
    end

    -- 🛡️ BLOQUEO DE REGRESO — Reafirma la posición varias veces
    if BLOQUEAR_REGRESO then
        local TiempoInicio = os.clock()
        while os.clock() - TiempoInicio < TIEMPO_PROTECCION and Activo do
            task.wait(0.05)
            -- Si te movió, te regresa a la zona segura
            if (HRP.Position - ZONA_SEGURA).Magnitude > 3 then
                HRP.CFrame = CFrame.new(ZONA_SEGURA)
            end
        end
    end

    Activo = false
end

-- ⛔ PARAR
local function Parar()
    Activo = false
end

-- 🖱️ ARRASTRAR
local function HacerMovible(Elemento)
    local Arrastrando = false
    local Diferencia = Vector2.new()

    Elemento.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Arrastrando = true
            Diferencia = UIS:GetMouseLocation() - Vector2.new(Elemento.AbsolutePosition.X, Elemento.AbsolutePosition.Y)
            Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then
                    Arrastrando = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(Input)
        if Arrastrando and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
            local Pos = UIS:GetMouseLocation() - Diferencia
            Elemento.Position = UDim2.new(0, Pos.X, 0, Pos.Y)
        end
    end)
end

