--  TP + REJOIN AUTO-EJECUTABLE
--  Al volver a entrar → carga el script solo
-- =============================================

local Player = game:GetService("Players").LocalPlayer
local UIS = game:GetService("UserInputService")
local TService = game:GetService("TeleportService")

-- 📍 CONFIGURACIÓN
local JUEGO_ID = 77881572888789
local ZONA_SEGURA     = Vector3.new(340.52, 4.00, -1.42)    -- ⚡ Zona Segura
local ZONA_FOREST     = Vector3.new(3605.74, 4.00, -0.99)   -- 🌲 Forest
local ZONA_CEMENTERIO = Vector3.new(2965.09, 4.00, -41.94)  -- 🪦 Cementerio

-- 🔗 TU SCRIPT QUE SE CARGA SOLO
local SCRIPT_URL = "https://raw.githubusercontent.com/GetFreeSeedPack/RobaunEggDePayaso/main/Steal%20Egg%20Payaso"

-- ⚡ VELOCIDAD
local ALTITUD_SEGURA = 1.0
local RETRASO_ANTI = 0.006
local BLOQUEAR_REGRESO = true
local TIEMPO_PROTECCION = 1.5

local Activo = false
local RejoinActivo = false
local MenuMinimizado = false

-- ✅ EJECUTAR TU SCRIPT AUTOMÁTICAMENTE
local function EjecutarScript()
    task.wait(1) -- Espera a que cargue bien
    local exito, error = pcall(function()
        loadstring(game:HttpGet(SCRIPT_URL))()
    end)
    if not exito then
        warn("⚠️ No se pudo cargar el script: " .. tostring(error))
    end
end

-- 🛡️ TP SEGURO
local function IrAZona(Destino)
    if Activo then return end
    Activo = true

    local Char = Player.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then
        Activo = false
        return
    end
    local HRP = Char.HumanoidRootPart
    local Inicio = HRP.Position
    local DestinoFinal = Destino + Vector3.new(0, ALTITUD_SEGURA, 0)

    local Pasos = 5
    for i = 1, Pasos do
        if not Activo then break end
        local Progreso = i / Pasos
        local NuevaPos = Inicio:Lerp(DestinoFinal, Progreso)
        HRP.CFrame = CFrame.new(NuevaPos)
        task.wait(RETRASO_ANTI)
    end

    if Activo then
        HRP.CFrame = CFrame.new(Destino + Vector3.new(0, 0.5, 0))
        task.wait(0.015)
        HRP.CFrame = CFrame.new(Destino + Vector3.new(0, 0.15, 0))
        task.wait(0.015)
        HRP.CFrame = CFrame.new(Destino)
    end

    if BLOQUEAR_REGRESO then
        local TiempoInicio = os.clock()
        while os.clock() - TiempoInicio < TIEMPO_PROTECCION and Activo do
            task.wait(0.05)
            if HRP and (HRP.Position - Destino).Magnitude > 3 then
                HRP.CFrame = CFrame.new(Destino)
            end
        end
    end

    Activo = false
end

-- 🔄 REJOIN + CARGA EL SCRIPT SOLO
local function Rejoin()
    if RejoinActivo then return end
    RejoinActivo = true
    task.spawn(function()
        task.wait(0.3)
        TService:TeleportToPlaceInstance(JUEGO_ID, game.JobId, Player)
    end)
end

-- 🖱️ ARRASTRAR
local function HacerMovible(Elemento)
    local Arrastrando = false
    local Diferencia = Vector2.new()
    Elemento.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Arrastrando = true
            Diferencia = UIS:GetMouseLocation() - Vector2.new(Elemento.AbsolutePosition.X, Elemento.AbsolutePosition.Y)
            Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then
                    Arrastrando = false
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(Input)
        if Arrastrando and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
            local Pos = UIS:GetMouseLocation() - Diferencia
            Elemento.Position = UDim2.new(0, Pos.X, 0, Pos.Y)
        end
    end)
end

