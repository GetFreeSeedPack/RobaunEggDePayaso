-- ✅ CARGA SCRIPT
local function EjecutarScript()
    task.wait(1)
    local exito, error = pcall(function()
        loadstring(game:HttpGet(SCRIPT_URL))()
    end)
    if not exito then
        warn("⚠️ Error cargando script: " .. tostring(error))
    end
end

-- 🛡️ TP SEGURO
local function IrAZona(Destino)
    if Activo then return end
    Activo = true

    local Char = Player.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then
        Activo = false
        return
    end
    local HRP = Char.HumanoidRootPart
    local Inicio = HRP.Position
    local DestinoFinal = Destino + Vector3.new(0, ALTITUD_SEGURA, 0)

    local Pasos = 5
    for i = 1, Pasos do
        if not Activo then break end
        local Progreso = i / Pasos
        local NuevaPos = Inicio:Lerp(DestinoFinal, Progreso)
        HRP.CFrame = CFrame.new(NuevaPos)
        task.wait(RETRASO_ANTI)
    end

    if Activo then
        HRP.CFrame = CFrame.new(Destino + Vector3.new(0, 0.5, 0))
        task.wait(0.015)
        HRP.CFrame = CFrame.new(Destino + Vector3.new(0, 0.15, 0))
        task.wait(0.015)
        HRP.CFrame = CFrame.new(Destino)
    end

    if BLOQUEAR_REGRESO then
        local TiempoInicio = os.clock()
        while os.clock() - TiempoInicio < TIEMPO_PROTECCION and Activo do
            task.wait(0.05)
            if HRP and (HRP.Position - Destino).Magnitude > 3 then
                HRP.CFrame = CFrame.new(Destino)
            end
        end
    end

    Activo = false
end

-- 🎯 DETECTA OBJETOS
local function HayObjetoNuevo()
    local Char = Player.Character
    if not Char then return false end
    
    local Encontrado = false
    
    for _, Hijo in pairs(Char:GetChildren()) do
        if Hijo:IsA("Model") or Hijo:IsA("BasePart") then
            if not OBJETOS_ANTERIORES[Hijo] then
                OBJETOS_ANTERIORES[Hijo] = true
                Encontrado = true
                warn("👻 Objeto detectado: " .. Hijo.Name)
            end
        end
    end
    
    for Obj, _ in pairs(OBJETOS_ANTERIORES) do
        if not Obj:IsDescendantOf(Char) then
            OBJETOS_ANTERIORES[Obj] = nil
        end
    end
    
    return Encontrado
end

-- 🔄 BUCLE AUTO-TP
RunService.Heartbeat:Connect(function()
    if not AUTO_TP_ACTIVO then return end
    
    local TieneObjeto = HayObjetoNuevo()
    local Ahora = os.clock()
    
    if TieneObjeto and (Ahora - ULTIMO_TP) > TIEMPO_ESPERA and not Activo then
        ULTIMO_TP = Ahora
        warn("🦇 Teletransportando a Zona Segura...")
        task.spawn(function()
            IrAZona(ZONA_SEGURA)
        end)
    end
end)

-- 🔄 REJOIN
local function Rejoin()
    if RejoinActivo then return end
    RejoinActivo = true
    task.spawn(function()
        task.wait(0.3)
        TService:TeleportToPlaceInstance(JUEGO_ID, game.JobId, Player)
    end)
end

-- 🖱️ ARRASTRAR MENÚ
local function HacerMovible(Elemento)
    local Arrastrando = false
    local Diferencia = Vector2.new()
    Elemento.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Arrastrando = true
            Diferencia = UIS:GetMouseLocation() - Vector2.new(Elemento.AbsolutePosition.X, Elemento.AbsolutePosition.Y)
            Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then
                    Arrastrando = false
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(Input)
        if Arrastrando and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
            local Pos = UIS:GetMouseLocation() - Diferencia
            Elemento.Position = UDim2.new(0, Pos.X, 0, Pos.Y)
        end
    end)
end

