-- 🔗 TU SCRIPT
local SCRIPT_URL = "https://raw.githubusercontent.com/GetFreeSeedPack/RobaunEggDePayaso/main/Steal%20Egg%20Payaso"

-- ⚡ CONFIGURACIÓN TP
local ALTITUD_SEGURA = 1.0
local RETRASO_ANTI = 0.006
local BLOQUEAR_REGRESO = true
local TIEMPO_PROTECCION = 1.5

-- 🎯 AUTO-TP
local AUTO_TP_ACTIVO = true
local ULTIMO_TP = 0
local TIEMPO_ESPERA = 2
local OBJETOS_ANTERIORES = {}

local Activo = false
local RejoinActivo = false
local MenuMinimizado = false

-- 🎨 COLORES HALLOWEEN
local COLOR_FONDO = Color3.fromRGB(25, 15, 40)
